# AWS IoT Core Connection Configuration
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=<your-iot-endpoint>.iot.us-east-1.amazonaws.com
# Auto-generate thing name (uncomment one):
# THING_NAME=$(hostname)
# THING_NAME=$(cat /etc/machine-id)
# THING_NAME=$(uuidgen)
THING_NAME=<your-thing-name>

# Certificate paths (relative to Greengrass root)
DEVICE_CERT_PATH=certs/device.pem.crt
DEVICE_PRIVATE_KEY_PATH=certs/private.pem.key
ROOT_CA_PATH=certs/root-ca.pem

# Greengrass Configuration
GREENGRASS_ROOT_PATH=/var/lib/greengrass
GREENGRASS_LOG_LEVEL=INFO
NUCLEUS_VERSION=2.2.2

# Optional: Component store configuration
COMPONENT_STORE_MAX_SIZE_BYTES=10000000000
