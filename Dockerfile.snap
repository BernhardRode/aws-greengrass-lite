ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

# Install all build dependencies + snapd + sudo
RUN apt-get update && apt-get install -y \
    squashfs-tools \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    libcurl4-openssl-dev \
    libjson-c-dev \
    libsystemd-dev \
    libsqlite3-dev \
    libyaml-dev \
    uuid-dev \
    libevent-dev \
    liburiparser-dev \
    libzip-dev \
    git \
    snapd \
    systemd \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy source code
COPY . /workspace
WORKDIR /workspace

# Manual build process
RUN VERSION=$(cat version) && \
    ARCH=$(dpkg --print-architecture) && \
    mkdir -p snap-build/usr/bin && \
    cmake -B build -DCMAKE_BUILD_TYPE=RelWithDebInfo -DGGL_SYSTEMD_SERVICE_BUILD=OFF -DCMAKE_INSTALL_PREFIX=/usr && \
    make -C build -j$(nproc) && \
    make -C build install DESTDIR=/workspace/snap-build && \
    mkdir -p snap-build/meta && \
    sed "s/version: '2.2.2'/version: '$VERSION'/" snap/snapcraft.yaml > snap-build/meta/snap.yaml && \
    mksquashfs snap-build aws-greengrass-lite_${VERSION}_${ARCH}.snap -comp xz && \
    mkdir -p /var/lib/greengrass /var/log/greengrass /etc/greengrass

# Startup script
RUN echo '#!/bin/bash\n\
set -e\n\
echo "AWS Greengrass Lite starting..."\n\
\n\
# Load environment variables if .env exists\n\
if [ -f /workspace/.env ]; then\n\
    source /workspace/.env\n\
    echo "Loaded configuration from .env"\n\
else\n\
    echo "No .env file found. Using defaults or environment variables."\n\
fi\n\
\n\
# Set default values\n\
GREENGRASS_ROOT_PATH=${GREENGRASS_ROOT_PATH:-/var/lib/greengrass}\n\
THING_NAME=${THING_NAME:-$(hostname)}\n\
VERSION=$(cat version)\n\
ARCH=$(dpkg --print-architecture)\n\
\n\
echo "Thing Name: $THING_NAME"\n\
echo "Greengrass Root: $GREENGRASS_ROOT_PATH"\n\
echo "Version: $VERSION"\n\
echo "Architecture: $ARCH"\n\
\n\
# Extract snap and start services\n\
echo "Extracting snap package..."\n\
unsquashfs -d /tmp/greengrass aws-greengrass-lite_${VERSION}_${ARCH}.snap >/dev/null 2>&1\n\
\n\
# Start ggconfigd in background\n\
echo "Starting ggconfigd..."\n\
/tmp/greengrass/usr/bin/ggconfigd &\n\
GGCONFIG_PID=$!\n\
\n\
# Wait a moment for ggconfigd to start\n\
sleep 2\n\
\n\
# Start iotcored\n\
echo "Starting iotcored..."\n\
exec /tmp/greengrass/usr/bin/iotcored\n\
' > /start-greengrass.sh && chmod +x /start-greengrass.sh

CMD ["/start-greengrass.sh"]
